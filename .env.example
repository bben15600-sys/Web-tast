# ── Server-only secrets (NEVER prefix with VITE_, that would leak to the browser) ──

# Notion integration token. Create an internal integration at
# https://www.notion.so/my-integrations and share each target database with it.
NOTION_API_TOKEN=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Money Master lives under a different Notion integration. /api/notion picks
# this token when the client sends `integration: "mm"` in the request body.
NOTION_MM_API_TOKEN=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional allowlist: comma-separated Notion database IDs that /api/notion
# is permitted to proxy. If unset, any database the integration can access
# is queryable via the proxy.
NOTION_ALLOWED_DATABASES=

# OpenRouter API key (https://openrouter.ai/keys). Server-only — /api/chat
# uses this to proxy chat completions with streaming.
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Finnhub API key (https://finnhub.io/dashboard — free tier 60 req/min).
# Used as a fallback for /api/yahoo/quote when Yahoo is unavailable. NOTE:
# Finnhub's /stock/candle is locked behind a paid tier since 2024, so the
# free key won't help with /api/yahoo/chart. Use TWELVE_DATA_API_KEY for
# chart fallbacks.
FINNHUB_API_KEY=

# Twelve Data API key (https://twelvedata.com/account — free tier 800
# calls/day, 8/min). Used as a fallback for /api/yahoo/chart when Yahoo
# rate-limits Vercel's IP range. Strongly recommended — Yahoo blocks
# cloud-provider IPs intermittently and Finnhub free no longer offers
# historical candles.
TWELVE_DATA_API_KEY=

# Anthropic API key (https://console.anthropic.com/settings/keys).
# Used by /api/claude, /api/daily-insight, /api/health-insight,
# /api/parse-recipe-url. Server accepts any of:
# ANTHROPIC_API_KEY, ANTHROPIC_KEY, ANTHROPIC_TOKEN, CLAUDE_API_KEY, CLAUDE_KEY, CLAUDE_TOKEN
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Strava OAuth (https://www.strava.com/settings/api).
# STRAVA_REDIRECT_URI must match the "Authorization Callback Domain" of your app
# and end with "/api/strava/callback" (e.g. https://aurora.example.com/api/strava/callback).
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=

# ── Public (exposed to the browser) ──

# Database ID for the Schedule page. Database IDs are not secret — they grant
# no access on their own; all reads go through the server with NOTION_API_TOKEN.
VITE_NOTION_SCHEDULE_DB_ID=

# Weekly goals DB (home page). Schema tolerates either English or Hebrew
# property names: Name/שם (title), Done/בוצע (number), Target/יעד (number),
# optional Color/צבע (select or #hex rich-text).
VITE_NOTION_GOALS_DB_ID=
VITE_NOTION_INVESTMENTS_DB_ID=

# Money Master (Budget page) — 3 separate databases under one Notion cover.
# VITE_NOTION_BUDGET_DB_ID holds categories (name, emoji, monthly budget,
# pre-computed formulas for current-month spent/remaining/percent).
# The other two hold raw expense / income records.
VITE_NOTION_BUDGET_DB_ID=
VITE_NOTION_EXPENSES_DB_ID=
VITE_NOTION_INCOME_DB_ID=

# Recipes DB (Kitchen page → Recipes tab). Properties (Hebrew or English):
# שם/Name (title), מנות/Servings, זמן (דקות)/Time, רמת קושי/Difficulty,
# תיאור/Description, קטגוריה/Category, מצרכים/Ingredients, הוראות/Steps.
VITE_NOTION_RECIPES_DB_ID=

# Meal Plan DB (Kitchen page → תכנון tab). Properties:
# תאריך/Date (date), ארוחה/Meal (select: בוקר/צהריים/ערב/נשנוש),
# מתכון/Recipe (relation → Recipes), הערות/Notes.
VITE_NOTION_MEALPLAN_DB_ID=

# Pantry DB (Kitchen page → מלאי tab). Properties:
# שם/Name (title), כמות/Quantity (number), יחידה/Unit (rich_text),
# קטגוריה/Category (select), סף הזמנה/ReorderAt (number), אימוג׳י/Emoji (rich_text).
VITE_NOTION_PANTRY_DB_ID=

# Activity log DB (Health page). Properties:
# שם/Name (title), תאריך/Date, סוג/Type (select: כדורסל/טניס/ריצה/כושר/אופניים/שחייה/אחר),
# משך (דקות)/Duration (number), קלוריות/Calories (number), הערות/Notes.
VITE_NOTION_ACTIVITY_DB_ID=

# Sleep log DB. Properties:
# תאריך/Date, שעות/Hours (number), איכות/Quality (select: מצוין/טוב/בינוני/גרוע).
VITE_NOTION_SLEEP_DB_ID=

# Weight log DB. Properties:
# תאריך/Date, משקל/Weight (number, kg).
VITE_NOTION_WEIGHT_DB_ID=
